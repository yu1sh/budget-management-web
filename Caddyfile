:80 {
  encode zstd gzip
  reverse_proxy app:8000 {
    # Cloudflare Tunnel terminates public TLS and connects locally over HTTP.
    header_up X-Forwarded-Proto https
  }
  header {
    Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:"
    Permissions-Policy "camera=(), geolocation=(), microphone=()"
  }
}
